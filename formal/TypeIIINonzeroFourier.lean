      (h₁ : (b₁ : ℤ) * ℓ.1 ∈ Finset.Icc (Int.ceil (-T₁)) (Int.floor T₁))
      (h₂ : (b₂ : ℤ) * ℓ.2.1 ∈ Finset.Icc (Int.ceil (-T₂)) (Int.floor T₂))
      (h₃ : (b₃ : ℤ) * ℓ.2.2 ∈ Finset.Icc (Int.ceil (-T₃)) (Int.floor T₃)) :
      |((ℓ.1 * ℓ.2.1 * ℓ.2.2 : ℤ) : ℝ)| ≤
        T₁ * T₂ * T₃ / ((b₁ * b₂ * b₃ : ℕ) : ℝ) := by
    have hcoordinate (T : ℝ) (b : ℕ) (hb : 0 < b) (z : ℤ)
        (hz : (b : ℤ) * z ∈ Finset.Icc (Int.ceil (-T)) (Int.floor T)) :
        |(z : ℝ)| ≤ T / (b : ℝ) := by
      obtain ⟨hlo, hhi⟩ := Finset.mem_Icc.mp hz
      have habs : |(((b : ℤ) * z : ℤ) : ℝ)| ≤ T :=
        abs_le.mpr ⟨Int.ceil_le.mp hlo, Int.le_floor.mp hhi⟩
      rw [Int.cast_mul, Int.cast_natCast, abs_mul,
        abs_of_nonneg (Nat.cast_nonneg b)] at habs
      apply (le_div_iff₀ (by exact_mod_cast hb : 0 < (b : ℝ))).2
      simpa only [mul_comm] using habs
    have hu := hcoordinate T₁ b₁ hb₁ ℓ.1 h₁
    have hv := hcoordinate T₂ b₂ hb₂ ℓ.2.1 h₂
    have hw := hcoordinate T₃ b₃ hb₃ ℓ.2.2 h₃
