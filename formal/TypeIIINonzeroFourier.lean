                  (h.1 : ZMod (q : ℕ)) (h.2.1 : ZMod (q : ℕ))
                  (h.2.2 : ZMod (q : ℕ)) (a q * hm.unit⁻¹)
            else 0
        ‖V‖ ≤ K * Wc * Wη * Wα * Real.sqrt ((2 * Tψ + 3) * Lw) *
          (M * N) * x ^ (-3 * ε) := by
  have hweight_algebra (r b wc we wa s t z root : ℝ) :
      (r / b ^ 2) * (4 * wc * ((8 * C) * (2 * we) * wa * s * t / (b * root) * z)) =
        ((64 * C) * wc * we * wa * s * t * z) * (r / (root * b ^ 3)) := by
    simp only [div_eq_mul_inv, mul_inv_rev, ← inv_pow]
