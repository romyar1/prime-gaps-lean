theorem LocalFourierHypothesis.fineBand_nonzero_fourier_power_saving
    {C₀ : ℝ} (hC₀ : 0 ≤ C₀) {D₀ p₀ : ℕ} (hlocal : LocalFourierHypothesis C₀ D₀ p₀)
    (omegaExp δ σ C : ℝ)
    (hω : 0 < omegaExp) (hδ : 0 < δ) (hC : 1 ≤ C) (hσupper : σ < 1 / 6)
    (hσ : 1 / 30 + 56 * omegaExp / 15 + 4 * δ / 15 < σ)
