      dsimp only [B, Wα]
      ring
    _ = B * x ^ (1 - 3 * ε / 4) * Real.log x := by rw [hpower]
    _ ≤ B * x ^ (1 - 3 * ε / 4) * x ^ (ε / 4) :=
      mul_le_mul_of_nonneg_left hlogsmall (by positivity)
    _ = B * x ^ (1 - ε / 2) := by
      rw [mul_assoc, ← Real.rpow_add hx0]
      congr 1
      ring_nf
    _ ≤ B * x / (Real.log x) ^ A := by
      apply (le_div_iff₀ (Real.rpow_pos_of_pos hlog0 A)).mpr
      calc
        _ ≤ B * x ^ (1 - ε / 2) * x ^ (ε / 2) :=
          mul_le_mul_of_nonneg_left hlogA (by positivity)
