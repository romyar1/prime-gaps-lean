      (inv_le_one_of_one_le₀ hCtwo)
  have hbins : (bins : ℝ) ≤ Acov * x ^ ε * Real.log x := by
    clear * - hCpos hx0 hlogC haExp hxlog hx1 hε hlogr hρ hrhoinverse hr hQmax
