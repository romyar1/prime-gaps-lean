      _ ≤ Real.log r := Real.le_log_one_add_of_nonneg hρ.le
  have hrhoinverse : ρ⁻¹ ≤ x ^ ε := by
    clear * - hCtwo hx0 ρ
    dsimp only [ρ]
    rw [mul_inv_rev, ← Real.rpow_neg hx0.le (-ε), neg_neg]
