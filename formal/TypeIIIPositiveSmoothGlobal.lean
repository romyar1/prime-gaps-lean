      (∑ n ∈ f.support, if (n : ZMod (q : ℕ)) = a then f n else 0) =
        R q a := by
    clear * - hpair
    simpa only [R, Int.cast_natCast, mul_ite, mul_one, mul_zero] using
      hpair (fun z => if (z : ZMod (q : ℕ)) = a then 1 else 0)
  have hU (q : ℕ+) :
      (∑ n ∈ f.support, if Nat.Coprime n (q : ℕ) then f n else 0) = U q := by
    clear * - hpair
    simpa only [U, Int.cast_natCast, ZMod.isUnit_iff_coprime,
      mul_ite, mul_one, mul_zero] using
      hpair (fun z => if IsUnit (z : ZMod (q : ℕ)) then 1 else 0)
  let a : ∀ q : ℕ+, (ZMod (q : ℕ))ˣ := fun q =>
    if hq : q ∈ Qset then (ha₀ q hq).unit else 1
  have ha : ∀ q ∈ Qset, (a q : ZMod (q : ℕ)) = (a₀ : ZMod (q : ℕ)) := by
    intro q hq
    simp only [a, dite_eq_left hq, IsUnit.unit_spec]
  have hsym (ψ : ℝ → ℂ) (hs : Function.support ψ ⊆ Set.Icc (1 / C) C) :
      Function.support ψ ⊆ Set.Icc (-C) C :=
    hs.trans (Set.Icc_subset_Icc_left
      ((neg_nonpos.mpr hCpos.le).trans (one_div_pos.mpr hCpos).le))
  have hper (j : ℕ) (hj : j ∈ Finset.range bins) :
      ∑ q ∈ Qset.filter (fun q => label q = j),
        ‖R q (a q : ZMod (q : ℕ)) - U q / ((q : ℕ).totient : ℂ)‖ ≤
