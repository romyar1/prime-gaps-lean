  clear * - hper hlabels hbins hR hU ha hMNphyshi hCpos hKp hAcov hKα
    hLα hL₁ hL₂ hL₃ hWα hM0 hN0 hx0 hlog0 hlogsmall hlogA
  let B : ℝ := 2 * Kp * Acov * Kα * C ^ 2 * (Lα * L₁ * L₂ * L₃)
  have hB : 0 ≤ B := by dsimp only [B]; positivity
  have hbulk : 0 ≤ 2 * Kp * (L₁ * L₂ * L₃) * Wα := by positivity
  have hcover : 0 ≤ Acov * x ^ ε * Real.log x := by positivity
  have hpower : x ^ ε * x ^ (ε / 4) * x * x ^ (-2 * ε) =
