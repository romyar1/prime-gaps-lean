          rw [mul_assoc, ← Real.rpow_add hx0]
          simp
    _ ≤ K * (Lα * L₁ * L₂ * L₃) * x / (Real.log x) ^ A := by
      apply div_le_div_of_nonneg_right _ (Real.rpow_nonneg hlog0.le _)
      apply mul_le_mul_of_nonneg_right _ hx0.le
      exact mul_le_mul_of_nonneg_right (le_add_of_nonneg_left zero_le_one) (by positivity)


