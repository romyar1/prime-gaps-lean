info: formal/TypeIIILocalProgress.lean:307:0: PrimeGap182.TypeIII.HasFiniteExceptionalTypeIIIInput : Prop
info: formal/TypeIIILocalProgress.lean:308:0: def PrimeGap182.TypeIII.HasFiniteExceptionalTypeIIIInput : Prop :=
∃ C, 0 < C ∧ ∃ D p₀, PrimeGap182.TypeIII.LocalFourierHypothesis C D p₀
info: formal/TypeIIILocalProgress.lean:309:0: def PrimeGap182.TypeIII.LocalFourierHypothesis : ℝ → ℕ → ℕ → Prop :=
fun C D p₀ =>
  ∀ (p : ℕ) [inst : Fact (Nat.Prime p)],
    p₀ < p →
      ∀ (α m m' n n' : ZMod p),
        α ≠ 0 →
          m ≠ 0 →
            m' ≠ 0 →
              n ≠ 0 →
                n' ≠ 0 →
                  (m ≠ m' ∧ n ≠ n' → PrimeGap182.TypeIII.FiniteExceptionalFourierBound p C D α m m' n n') ∧
                    (m = m' ∨ n = n' → PrimeGap182.TypeIII.CurveExceptionalFourierBound p C D α m m' n n')
